# The biffix-owned engine plugins the base coordinator image ships in /opt/biffix/wheels/ for the
# runtime build (codebuild/runtime/build.sh) to install. Kept equal to the Snakemake pin table
# in crates/biffix-workflow/src/runtime/pins.rs by a test in runtime/tests.rs; the logger and
# nf-biffix versions come from their own build files.
EXECUTOR_REPO=https://github.com/nh13/snakemake-executor-plugin-aws-batch.git
EXECUTOR_SHA=0ac5ec4ea45a0c278876a598b17327213e964483
# The coordinator contract this source's coordinator implements, recorded in the manifest for the
# runtime build to check against a recipe's minimum: bumped whenever the coordinator gains a launch
# feature a version may depend on (crates/biffix-workflow/src/runtime/mod.rs COORDINATOR_CONTRACT,
# which a test keeps equal to this). 1: BIFFIX_QUEUE_ASSIGNMENT. 2: single-job execution
# (BIFFIX_EXECUTION=single_job) with nested Apptainer.
COORDINATOR_CONTRACT=2
