manifest {
    name = 'single-job-nf-acceptance'
    nextflowVersion = '25.10.4'
}

plugins {
    id 'nf-schema@2.7.2'
}

// The optional acceptance parameters' defaults: a JSON Schema `default` fills nothing in.
params {
    validation_case = 'success'
    expect_apptainer = true
}

process {
    shell = ['/bin/bash', '-euo', 'pipefail']
}
