{
  "name": "biffix-ui",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "biffix web app: launch, follow and browse Snakemake and Nextflow runs (SvelteKit static build → S3 + CloudFront).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "mock": "node mock/server.mjs",
    "generate:api": "node ./scripts/generate-api.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check .",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.12.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "24.13.6",
    "fast-check": "3.23.2",
    "jsdom": "30.1.3",
    "json-schema-to-typescript": "16.0.0",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^5.6.0",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "igv": "3.8.10",
    "marked": "18.1.1",
    "swagger-ui-dist": "^5.33.3",
    "yaml": "2.9.1"
  }
}
