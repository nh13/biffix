#!/usr/bin/env bash
# biffix pre-push hook: run the quick subset of CI's gates locally, with the same commands and the
# same scope CI uses, so a format, lint or type error fails here instead of on CI.
#
# What it runs (each only when its toolchain is present; a missing tool is reported as skipped):
#   rust   cargo fmt --all --check
#          cargo clippy --workspace --all-targets --all-features -- -D warnings
#   infra  uv run ruff check .  /  uv run ruff format --check .
#   coordinator (docker/coordinator)  the same ruff checks
#   Snakemake logger (plugins/snakemake-logger-plugin-biffix)  the same ruff checks
#   ui     prettier --check .  /  svelte-kit sync + svelte-check  (only when ui/node_modules exists)
#   lint   actionlint  /  shellcheck -x over every tracked *.sh and this hook
#
# What it skips, on purpose, because each takes minutes: cargo test and the Postgres-backed tests,
# the schema-drift check, the UI's generated-types drift check, vitest, playwright and the UI build,
# the plugin test suites, and the infra synth tests. CI runs all of them.
#
# Clippy and svelte-check are fast on a warm build but slow on a cold one (a fresh clone or
# worktree). Set BIFFIX_PREPUSH_QUICK=1 to skip those two; everything else still runs. Bypass the
# hook entirely, once, with `git push --no-verify`.
#
# Enable in a clone with:  git config core.hooksPath .githooks
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)" || exit 1
cd "$ROOT" || exit 1
FAIL=0
QUICK="${BIFFIX_PREPUSH_QUICK:-0}"

note() { printf '\033[1;36m[pre-push]\033[0m %s\n' "$1" >&2; }
skip() { printf '  skip %s (%s)\n' "$1" "$2" >&2; }

# check <description> <command-string>. The command runs in a subshell (so a `cd` inside it does
# not leak), and its output is shown only on failure.
check() {
  local desc="$1" cmd="$2" out
  if out="$(eval "$cmd" 2>&1)"; then
    printf '  ok   %s\n' "$desc" >&2
  else
    printf '  FAIL %s\n' "$desc" >&2
    printf '%s\n' "$out" | sed 's/^/       /' | head -40 >&2
    FAIL=1
  fi
}

note "pre-push checks (tests, drift gates, e2e and synth run in CI only)"

# Rust.
if command -v cargo >/dev/null 2>&1; then
  check "cargo fmt --all --check" "cargo fmt --all --check"
  if [ "$QUICK" = 1 ]; then
    skip "cargo clippy" "BIFFIX_PREPUSH_QUICK=1"
  else
    check "cargo clippy (all features, -D warnings)" \
      "cargo clippy --workspace --all-targets --all-features -- -D warnings"
  fi
else
  skip "rust checks" "cargo not found"
fi

# The Python projects: ruff lint + format over each whole project, through uv, exactly as CI runs
# them. Each entry is `<label>:<dir>`.
PY_PROJECTS="infra:infra coordinator:docker/coordinator snakemake-logger:plugins/snakemake-logger-plugin-biffix"
for entry in $PY_PROJECTS; do
  label=${entry%%:*} dir=${entry#*:}
  if [ -d "$dir" ] && command -v uv >/dev/null 2>&1; then
    check "$label ruff check ." "(cd $dir && uv run ruff check .)"
    check "$label ruff format --check ." "(cd $dir && uv run ruff format --check .)"
  else
    skip "$label ruff" "uv not found"
  fi
done

# Workflows and shell scripts, as CI's lint job checks them.
if command -v actionlint >/dev/null 2>&1; then
  check "actionlint" "actionlint"
else
  skip "actionlint" "actionlint not found"
fi
if command -v shellcheck >/dev/null 2>&1; then
  check "shellcheck -x" "git ls-files -z '*.sh' .githooks/ | xargs -0 shellcheck -x"
else
  skip "shellcheck" "shellcheck not found"
fi

# UI: the local binaries only, never npx (which can fetch or hang). svelte-check reads the
# tsconfig that `svelte-kit sync` generates, so sync first, as CI does.
if [ -x ui/node_modules/.bin/prettier ]; then
  check "ui prettier --check ." "(cd ui && ./node_modules/.bin/prettier --check . >/dev/null)"
  if [ "$QUICK" = 1 ]; then
    skip "ui svelte-check" "BIFFIX_PREPUSH_QUICK=1"
  elif [ -x ui/node_modules/.bin/svelte-check ] && [ -x ui/node_modules/.bin/svelte-kit ]; then
    check "ui svelte-check" \
      "(cd ui && ./node_modules/.bin/svelte-kit sync && ./node_modules/.bin/svelte-check --tsconfig ./tsconfig.json)"
  else
    skip "ui svelte-check" "svelte-check or svelte-kit not installed; run npm ci in ui/"
  fi
else
  skip "ui checks" "ui/node_modules not installed; run npm ci in ui/"
fi

if [ "$FAIL" -ne 0 ]; then
  note "push blocked; formatting fixes:"
  note "  cargo fmt --all"
  for entry in $PY_PROJECTS; do
    note "  (cd ${entry#*:} && uv run ruff format . && uv run ruff check --fix .)"
  done
  note "  (cd ui && ./node_modules/.bin/prettier --write .)"
  note "clippy and svelte-check findings need a manual fix."
  note "or bypass once: git push --no-verify"
  exit 1
fi

note "clean"
exit 0
